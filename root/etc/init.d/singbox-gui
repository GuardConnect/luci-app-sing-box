#!/bin/sh /etc/rc.common
USE_PROCD=1
START=98
STOP=10

start_service() {
	config_load singbox_gui
	local enabled
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	/usr/libexec/singbox-gui generate || return 1
	procd_open_instance main
	procd_set_param command /usr/libexec/singbox-gui-core run -c /var/run/singbox-gui/config.json
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /var/run/singbox-gui/config.json
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger singbox_gui
}
